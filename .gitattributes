# Set default behaviour to handle line endings automatically
* text=auto

# Explicitly declare text files to be normalised and converted to native line endings on checkout
*.py text diff=python
*.html text
*.json text
*.toml text
*.lock text
*.txt text
*.md text

# Declare files to always have LF line endings on checkout
*.sh text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.pdf binary
